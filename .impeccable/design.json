  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "화면의 다음 행동. 한 화면에 하나만 둔다.",
      "html": "<button class=\"ds-btn-primary\">이렇게 기록할게요</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:0.9375rem;font-weight:600;line-height:1.2;border:0;cursor:pointer;transition:background-color 120ms cubic-bezier(0.2,0,0,1);font-family:var(--font-sans);min-height:48px;padding:0 20px;border-radius:var(--radius-field);background:var(--color-brand);color:#fff}.ds-btn-primary:hover{background:var(--color-brand-hover)}.ds-btn-primary:active{background:var(--color-brand-hover)}.ds-btn-primary:focus-visible{outline:2px solid var(--color-brand);outline-offset:2px}.ds-btn-primary:disabled{background:var(--color-surface-muted);color:var(--color-ink-subtle);border:1px solid var(--color-line);cursor:not-allowed}"
    },
    {
      "name": "Approve Button",
      "kind": "button",
      "refersTo": "button-approve",
      "description": "승인 게이트 2곳 전용. 높이 52 · 전체 폭으로 다른 버튼과 구조적으로 구분된다.",
      "html": "<button class=\"ds-btn-approve\">캘린더에 등록할게요</button>",
      "css": ".ds-btn-approve{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:0.9375rem;font-weight:600;line-height:1.2;border:0;cursor:pointer;transition:background-color 120ms cubic-bezier(0.2,0,0,1);font-family:var(--font-sans);min-height:52px;width:100%;border-radius:var(--radius-field);background:var(--color-brand);color:#fff}.ds-btn-approve:hover{background:var(--color-brand-hover)}.ds-btn-approve:focus-visible{outline:2px solid var(--color-brand);outline-offset:2px}"
    },

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 🚨 재배포를 금지하는 라이선스의 폰트를 검토용으로 두는 자리 — 커밋되면 안 된다 (저장소 public · 최상위 §9).
# 지금 쓰는 폰트는 OFL 이라 원본을 fonts-src/ 에 커밋한다.
/.fonts-src

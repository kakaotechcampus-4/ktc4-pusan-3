# apps/web 환경변수 예시. 복사해서 .env.local 로 쓴다.
#
# 🚨 NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저 번들에 그대로 들어간다.
#    LLM API 키·DB 접속정보 같은 비밀은 여기에 절대 쓰지 않는다 (CLAUDE.md §9 · NF-09).
#    프론트가 아는 비밀은 "없다" 가 정답이다 — 인증은 로그인 후 받은 사용자 토큰뿐.

# FastAPI 서버 주소. 경로는 모두 이 아래 /api/v1 하위로 붙는다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 목(mock) 서버. enabled 면 MSW 가 계약서 v1 응답을 대신 내려준다 (src/mocks/).
# 개발 환경에서만 동작한다 — 프로덕션 빌드에는 msw 가 들어가지 않는다.
# 백엔드가 아직 없는 화면을 만들 때 켠다. 시나리오는 주소의 ?scenario= 로 바꾼다.
NEXT_PUBLIC_API_MOCKING=disabled

# Next 서버에서 난 오류를 Discord 로 알릴 웹훅 주소 (src/instrumentation.ts). NEXT_PUBLIC_ 이 아니라
# 브라우저엔 안 간다. 개발 모드(next dev)에서는 값이 있어도 보내지 않는다 — 배포 compose 가 넘겨 준다.
# 🚨 비밀 — 이 파일은 커밋된다. 값은 .env.local 이나 서버 .env 에만.
ALERT_WEBHOOK_URL=

# 웹 푸시 (일정 알림 · #609). Firebase 콘솔 › 프로젝트 설정에서 가져온다.
#   - 앞의 넷: 일반 › 내 앱 › 웹 앱 › SDK 설정 및 구성 (apiKey · projectId · messagingSenderId · appId)
#   - VAPID 키: 클라우드 메시징 › 웹 구성 › 웹 푸시 인증서의 "키 쌍" (공개 키). 🚨 새로 만들지 않는다 —
#     바꾸면 그 전에 받은 웹 토큰이 맞지 않는다
# 공개 식별자라 번들에 들어가도 되지만, 저장소가 public 이라 값은 여기 쓰지 않고 .env.local 과 서버 .env 에만 둔다.
# 비어 있으면 웹 푸시를 켜지 않는다. 서비스 계정 키(서버 비밀)는 웹이 쓰지 않는다.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

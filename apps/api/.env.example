# 실행 환경 (local | dev | prod)
APP_ENV=local

# 서비스 이름
APP_NAME=ktc4-pusan-3-api

# DB — docker-compose 의 POSTGRES_* 와 같은 값을 넣는다
# 비밀번호는 특수문자가 있어도 있는 그대로 적는다 (URL 인코딩 불필요)
DB_HOST=localhost
DB_PORT=5432
DB_USER=dev
DB_PASSWORD=dev
DB_NAME=dailyagent

# Elice Serverless API Key
MEMORY_API_KEY=

# Elice ML API endpoint. /v1 까지 포함
MEMORY_BASE_URL=

# 모델 ID
MEMORY_MODEL=

# 추론 강도 — none | low | medium | high
MEMORY_REASONING_EFFORT=

# Supervisor / Food / Activity / Growth / Health — 전부 선택. 비우면 MEMORY_* 값을 사용

SUPERVISOR_API_KEY=
SUPERVISOR_BASE_URL=
SUPERVISOR_MODEL=
SUPERVISOR_REASONING_EFFORT=

FOOD_API_KEY=
FOOD_BASE_URL=
FOOD_MODEL=
FOOD_REASONING_EFFORT=

ACTIVITY_API_KEY=
ACTIVITY_BASE_URL=
ACTIVITY_MODEL=
ACTIVITY_REASONING_EFFORT=

GROWTH_API_KEY=
GROWTH_BASE_URL=
GROWTH_MODEL=
GROWTH_REASONING_EFFORT=

HEALTH_API_KEY=
HEALTH_BASE_URL=
HEALTH_MODEL=
HEALTH_REASONING_EFFORT=

# Curator 임베딩 — 비워도 서버는 뜨고, 임베딩만 실행되지 않는다
# MEMORY_* 로 대체하지 않는다 (대화 모델로는 임베딩을 만들 수 없다)
# 모델 출력 차원이 1536 이어야 한다 (observation·profile 의 embedding 열이 vector(1536))
# BASE_URL 은 콘솔 화면 주소가 아니라 API 주소다. https://mlapi.run/<콘솔 예시 코드의 ID>/v1 형식
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# Curator 동일 대상 판정 — 새 관찰이 기존 Profile 과 같은 대상인지 묻는다 (OpenRouter · Jev)
# 비워도 서버는 뜬다. 판정이 필요한 관찰만 연결하지 않고 다음 실행으로 미룬다
# 보내는 값은 subject · 도메인 · 후보 merge_key 뿐이다 (원문 · 아이 id 없음)
CURATOR_JUDGE_API_KEY=
CURATOR_JUDGE_BASE_URL=https://openrouter.ai/api/alpha
CURATOR_JUDGE_MODEL=typesafe/jev-1.13

# 호출 튜닝 — 비우면 코드 기본값(60초, 2회)
LLM_TIMEOUT_S=
LLM_MAX_RETRIES=

# 급식표 사진 OCR — Elice MLAPI (2단계 지원, 팀 크레딧 월 ₩120,000 · 초과 시 키 자동 삭제)
# 엔드포인트는 모델마다 다르다 (Opus · Gemini 각각). 끝에 /v1 을 붙인다. 비우면 사진 입력만 비활성.
MEAL_OCR_BASE_URL=
MEAL_OCR_API_KEY=
MEAL_OCR_MODEL=gemini-3.1-pro-preview

# 브라우저에서 이 API 를 부를 수 있는 오리진. 쉼표로 구분한다.
# 비어 있으면 CORS 를 켜지 않는다 (같은 오리진 배포).
# 🚨 * 를 넣으면 부팅이 실패한다 — 이 API 는 Bearer 토큰으로 아이 정보를 내려준다.
# 로컬 예: http://localhost:3000
CORS_ALLOW_ORIGINS=

# ── 카카오 OAuth (#34) — 명세 docs/api/auth-kakao-v1.md §11 ──
# 🚨 실제 키를 여기 적지 않는다. 이 파일은 커밋된다 (CLAUDE.md §9).
#    APP_ENV=local · dev 면 아래 3개가 비어 있어도 서버는 정상 기동하고,
#    /auth/{provider}/status 가 ready: false 를 내려 프론트가 "카카오로 시작하기" 를
#    비활성화한다.
#    🚨 APP_ENV=prod 면 하나라도 비었을 때 서버가 뜨지 않는다 (#97) — 로그인 버튼만
#       꺼진 채 배포되는 것을 막는다.

# 콘솔 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# 콘솔 > 카카오 로그인 > 보안 에서 활성화 후 발급
KAKAO_CLIENT_SECRET=

# API 오리진의 절대 URL. 카카오 콘솔 등록값과 정확히 일치해야 한다 (운영·로컬 각각)
# 시작 URL 도 이 값의 오리진에서 파생한다 — 어긋나면 state 쿠키가 콜백에 실리지 않는다
KAKAO_CALLBACK_URL=

# 카카오 API 타임아웃 (초)
KAKAO_API_TIMEOUT=3

# 🚨 둘 다 필수. 하나라도 비어 있으면 서버가 뜨지 않는다 — 로그인을 마친 사용자를
#    돌려보낼 곳이라 없으면 인증이 성립하지 않는다.
#    배포에서는 실제 도메인으로 (예: https://<도메인>/auth/callback)
AUTH_RETURN_URL_WEB=http://localhost:3000/auth/callback

# 앱 복귀 스킴. 카카오 콘솔에 등록하지 않는다 (우리 서버가 302 하는 대상)
AUTH_RETURN_URL_APP=icatch://auth

# 수명 (초) — 세션 12시간 · 1회용 코드 2분 · 가입 티켓 10분 · state 쿠키 10분
SESSION_TTL=43200
HANDOFF_TTL=120
SIGNUP_TICKET_TTL=600
OAUTH_STATE_TTL=600

# 보호자별 하루 한 줄 입력 횟수 — 모델 크레딧(월 12만 원, 넘으면 키 삭제) 보호용
# 리허설처럼 많이 넣어야 할 때는 내 .env 에서만 올린다
INPUT_DAILY_LIMIT=5

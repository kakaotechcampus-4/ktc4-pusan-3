# 실행 환경 (local | dev | prod)
APP_ENV=local

# 서비스 이름
APP_NAME=ktc4-pusan-3-api

# DB — docker-compose 의 POSTGRES_* 와 같은 값을 넣는다
# 비밀번호는 특수문자가 있어도 있는 그대로 적는다 (URL 인코딩 불필요)
DB_HOST=localhost
DB_PORT=5432
DB_USER=dev
DB_PASSWORD=dev
DB_NAME=dailyagent

# Elice Serverless API Key
MEMORY_API_KEY=

# Elice ML API endpoint. /v1 까지 포함
MEMORY_BASE_URL=

# 모델 ID
MEMORY_MODEL=

# 추론 강도 — none | low | medium | high
MEMORY_REASONING_EFFORT=
# 실행 환경 (local | dev | prod)
APP_ENV=local

# 서비스 이름
APP_NAME=ktc4-pusan-3-api

# DB — docker-compose 의 POSTGRES_* 와 같은 값을 넣는다
# 비밀번호는 특수문자가 있어도 있는 그대로 적는다 (URL 인코딩 불필요)
DB_HOST=localhost
DB_PORT=5432
DB_USER=dev
DB_PASSWORD=dev
DB_NAME=dailyagent

# 급식표 OCR — Elice MLAPI (2단계 지원, 팀 크레딧 월 ₩120,000 · 초과 시 키 자동 삭제)
# 엔드포인트는 모델마다 다르다 (Opus·Gemini 각각). 끝에 /v1 을 붙인다. 확인: uv run python -m scripts.meal_ocr_eval --check
MLAPI_BASE_URL=https://mlapi.run/<team-endpoint-id>/v1
MLAPI_API_KEY=
MEAL_OCR_MODEL=gemini-3.1-pro-preview

# deploy/docker/.env 로 복사해서 쓴다. 이 파일 자체는 실제 값 없음.
# 여기 있는 두 묶음은 쓰는 compose 파일이 다르다 — 로컬 개발은 위쪽만 채우면 된다.

# ── 로컬 개발 DB (docker-compose.yml · make db-up) ────────────────────
# apps/api/.env.example 의 DB_USER/DB_PASSWORD/DB_NAME/DB_PORT 와 반드시 맞춘다.
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=dailyagent
POSTGRES_PORT=5432

# ── 배포 (docker-compose.deploy.yml · make web-image / web-up) ────────
# 프론트가 부를 FastAPI 주소. 경로는 모두 이 아래 /api/v1 하위로 붙는다.
#
# 🚨 이 값은 `next build` 가 번들에 문자열로 박는다 — 컨테이너 환경변수로 바꿀 수 없다.
#    고치면 make web-image 를 다시 돌린다 (apps/web/Dockerfile 머리말).
# 🚨 카카오 로그인은 이 값의 오리진과 서버의 KAKAO_CALLBACK_URL 오리진이 같아야 한다.
#    다르면 state 쿠키가 콜백에 실리지 않는다 (docs/api/auth-kakao-v1.md §5-5).
#    로컬은 포트가 달라도 쿠키가 공유돼 우연히 통과하니 배포 기준으로 확인할 것.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 호스트에서 열어 줄 포트. 컨테이너 안은 항상 3000 이다.
WEB_PORT=3000

# 이미지 태그. 기본 local. 배포에서 롤백하려면 커밋 해시 같은 것을 박아 쓴다.
WEB_IMAGE_TAG=local

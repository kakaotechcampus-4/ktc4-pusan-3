# deploy/docker/.env 로 복사해서 쓴다. 이 파일 자체는 실제 값 없음.
# 여기 있는 두 묶음은 쓰는 compose 파일이 다르다 — 로컬 개발은 위쪽만 채우면 된다.

# ── 로컬 개발 DB (docker-compose.yml · make db-up) ────────────────────
# apps/api/.env.example 의 DB_USER/DB_PASSWORD/DB_NAME/DB_PORT 와 반드시 맞춘다.
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=dailyagent
POSTGRES_PORT=5432

# ── 배포 (docker-compose.deploy.yml) ─────────────────────────────────
# 한 서버에 prod(main) · dev(develop) 두 checkout 이 있고 각자 이 파일을 한 벌씩 갖는다 (docs/ops/deploy-v1.md).
# 아래 세 줄이 둘을 가른다. prod 는 처음 둘을 비워 둔다 — 비우면 지금 이름(ktc4-deploy · ktc4-api …)이다.
#
#   prod: COMPOSE_PROJECT_NAME=          STACK_SUFFIX=       COMPOSE_PROFILES=edge  API_EDGE_IP=
#   dev : COMPOSE_PROJECT_NAME=ktc4-dev  STACK_SUFFIX=-dev   COMPOSE_PROFILES=      API_EDGE_IP=172.30.0.21
#
# 🚨 prod 에 COMPOSE_PROJECT_NAME 을 다른 값으로 쓰면 DB 볼륨 이름이 바뀌어 빈 DB 가 뜬다.
# COMPOSE_PROFILES=edge 는 Caddy(80/443) 를 띄운다 — 서버에 하나뿐이라 prod 만.
COMPOSE_PROJECT_NAME=
STACK_SUFFIX=
COMPOSE_PROFILES=edge
# api 의 ktc4-edge 주소. 비우면 172.30.0.20 — 서버 방화벽이 이 주소만 EC2 메타데이터에 닿게 한다
# (deploy/scripts/imds-firewall.sh). dev 는 172.30.0.21 이어야 한다 (deploy.sh 가 확인한다).
API_EDGE_IP=

# API 이미지 태그. 기본 local. 서버에서는 deploy/scripts/deploy.sh 가 커밋 sha 로 덮어 쓴다 — 여기 값은 손으로 띄울 때만.
API_IMAGE_TAG=local

# 프론트가 부를 FastAPI 주소. 경로는 모두 이 아래 /api/v1 하위로 붙는다.
#
# 🚨 이 값은 `next build` 가 번들에 문자열로 박는다 — 컨테이너 환경변수로 바꿀 수 없다.
#    고치면 로컬은 make web-image, 서버는 deploy.sh 로 다시 배포한다 (서버에서 make web-image 는 거부된다 · apps/web/Dockerfile 머리말).
# 🚨 카카오 로그인은 이 값의 오리진과 서버의 KAKAO_CALLBACK_URL 오리진이 같아야 한다.
#    다르면 state 쿠키가 콜백에 실리지 않는다 (docs/api/auth-kakao-v1.md §5-5).
#    로컬은 포트가 달라도 쿠키가 공유돼 우연히 통과하니 배포 기준으로 확인할 것.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 웹 푸시 (일정 알림 · #609). Firebase 콘솔 › 프로젝트 설정의 웹 앱 설정값과 웹 푸시 인증서 공개 키.
# 공개 식별자라 번들에 들어가도 되지만 저장소에는 값을 쓰지 않는다 (apps/web/.env.example 에 어디서 가져오는지).
# 🚨 **비워 두면 웹 푸시가 꺼진다.** 서버가 기기 토큰을 받기 시작한 뒤에 넣는다 — 처리방침 새 판 → apps/api/.env 의
#    PUSH_DEVICE_ACCEPT=true → 여기 (docs/web/web-push-v1.md "켜는 순서"). 앱의 권한 묻기도 이 값을 따른다.
# 🚨 다섯 개를 다 넣거나 다 비운다 — 일부만 넣으면 이미지 빌드가 멈춘다. 빌드 인자라 바꾸면 다시 굽는다 (로컬 make web-image · 서버 deploy.sh 재배포).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# 이미지 태그. 기본 local. API_IMAGE_TAG 와 같다 — 서버에서는 deploy.sh 가 커밋 sha 로 덮는다.
WEB_IMAGE_TAG=local

# 이 서버의 환경 이름 — 알림 머리의 꼬리표 [prod] · [dev] 가 된다. web(Next 서버 알림)과
# 컨테이너 감시가 같이 읽는다. 진짜 서버는 prod, 시험 서버는 dev. 비우면 prod.
# 🚨 api · web 은 이 값을 쓴다 — compose 의 environment 가 apps/api/.env 의 APP_ENV 를 덮는다.
#    dev 는 APP_ENV=dev 여야 한다 (deploy.sh 가 확인한다).
APP_ENV=prod

# 컨테이너 상태 감시(deploy/scripts/health-alert.sh, cron 1분)가 보낼 Discord 웹훅 주소.
# apps/api/.env 의 ALERT_WEBHOOK_URL 과 같은 값. 🚨 비밀 — 이 파일은 커밋되지 않는다.
ALERT_WEBHOOK_URL=

# DB 백업(deploy/scripts/backup.sh · restore-check.sh — #758)이 덤프를 올릴 S3 버킷 이름. 서울 리전.
# prod · dev checkout 이 같은 버킷을 쓰고 키 앞머리(APP_ENV)로 나뉜다. 버킷 설정(28일 수명 주기 ·
# EC2 역할만 접근)은 #758. 비밀은 아니지만 공개 저장소라 값은 서버 .env 에만 둔다.
# 🚨 비우면 백업이 실패하고, 배포 전 백업이 실패하면 배포가 멈춘다 — 이 줄을 넣은 뒤에 배포한다.
BACKUP_S3_BUCKET=

# 푸시 알림(FCM) 서비스 계정 키 JSON 의 서버 경로 (#594). api 컨테이너의
# /run/secrets/fcm-service-account.json 에 읽기 전용으로 붙는다 — 그때 apps/api/.env 에
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json 을 함께 넣는다.
# 🚨 비밀 — 키 파일은 저장소 밖 서버에만 둔다 (CLAUDE.md §9). 받는 법 → docs/notification/reminder-v1.md
FCM_KEY_PATH=

# 메모리 상한 (#780) — 🚨 dev 만 쓴다. prod 는 안 쓴다(줄이 없거나 비면 0 = 상한 없음 · 지금 그대로).
# 상한 없는 dev 가 폭주하면 커널이 운영 postgres 를 죽일 수 있다. 서버 3.7Gi + swap 2GB, 운영 합계 ~330MB.
# 넘치면 swap 없이 그 컨테이너만 죽고 restart 로 다시 뜬다 (memswap_limit 도 같은 값).
# 🚨 compose 는 빈 값도 0(상한 없음)으로 바꿔 오류 없이 띄운다 — dev 에서 네 개 중 하나라도 비거나 0 이면 deploy.sh 가 막는다.
#   dev: API_MEM_LIMIT=768m  WEB_MEM_LIMIT=384m  DB_MEM_LIMIT=512m  REDIS_MEM_LIMIT=128m
# API_MEM_LIMIT=
# WEB_MEM_LIMIT=
# DB_MEM_LIMIT=
# REDIS_MEM_LIMIT=

# dev 사이트(dev.icatch.ai.kr 전체 · api.dev 의 로그인 시작 · 콜백)를 팀만 열게 하는 basic_auth 계정 (#780).
# 🚨 prod .env 에만 넣는다 — 두 환경을 다 받는 Caddy 가 prod 프로젝트에 떠 있다. 비거나 깨지면 prod 배포가 멈춘다.
# 🚨 해시는 작은따옴표로 감싼다. 안 감싸면(큰따옴표도) compose 가 해시 속 $… 를 변수로 바꿔 늘 401 이다.
# 🚨 비밀 — 이 파일은 커밋되지 않는다. 해시 만드는 법(비밀번호가 셸 기록에 안 남는다 · docs/ops/deploy-v1.md):
#   PW="$(openssl rand -hex 16)"; echo "$PW"; printf '%s\n' "$PW" | docker run --rm -i httpd:2.4-alpine htpasswd -niBC 10 <이름>
#   → <이름>:$2y$10$… 의 : 뒤가 해시다.   DEV_BASIC_AUTH_HASH='$2y$10$...'
DEV_BASIC_AUTH_USER=
DEV_BASIC_AUTH_HASH=

# 컨테이너 로그 드라이버. 비우면 journald (서버용 — 컨테이너를 지워도 로그가 OS 에 남는다).
# 맥의 Docker Desktop 에는 journald 가 없어서, 배포 compose 를 로컬에서 띄워 볼 때만 json-file 로.
# LOG_DRIVER=json-file

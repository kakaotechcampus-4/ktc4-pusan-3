#!/bin/sh
# 선택형 pre-push 훅 (#770) — 프롬프트나 tool spec 을 바꿨으면 push 전에 LLM 없는 관련 테스트와
# 지문 고정 테스트를 돌린다. `make hooks` 로 켜고 `git config --unset core.hooksPath` 로 끈다.
#
#   SKIP_PROMPT_TEST=1 git push    # 이번 push 만 건너뛴다
#
# 매핑은 apps/api/scripts/prompt_scope.py 한 곳이고 `make test-prompt` 와 같다.
# 기준 브랜치(origin/develop)를 못 읽는 환경에서는 push 를 막지 않고 알리기만 한다.

if [ -n "$SKIP_PROMPT_TEST" ]; then
  echo "pre-push: SKIP_PROMPT_TEST 가 있어 프롬프트 테스트를 건너뜁니다."
  exit 0
fi

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root/apps/api" || exit 0

uv run python -m scripts.prompt_scope --run
status=$?

# 3 = 바뀐 파일을 못 읽음 (scripts/prompt_scope.py EXIT_NO_DIFF). pytest 의 2(수집 오류)는 막는다
if [ "$status" -eq 3 ]; then
  echo "pre-push: 바뀐 파일을 못 읽어 프롬프트 테스트를 건너뜁니다 (push 는 계속)."
  exit 0
fi
exit "$status"
